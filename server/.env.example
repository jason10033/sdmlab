# Copy to server/.env and fill in. Lines here never override real environment variables.

# Required for live AI features (extraction, screening, generation, surveillance triage).
# Get one at https://console.anthropic.com (billing must be enabled).
ANTHROPIC_API_KEY=

# Optional model override (default claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Fallback mode: with no API key set, MOCK_AI=1 lets the whole pipeline run with
# real PubMed/Reddit calls and clearly-labeled placeholder content where the AI
# would be. Ignored as soon as ANTHROPIC_API_KEY is set.
MOCK_AI=1

# Reddit API credentials (required for community discovery and Reddit surveillance).
# Create a free app at https://www.reddit.com/prefs/apps -> "create another app"
# -> type "script". The ID is under the app name; the secret is labeled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# First-run admin account (only used if the users table is empty)
# SEED_ADMIN_EMAIL=admin@sdmlab.local
# SEED_ADMIN_PASSWORD=changeme

# Bearer token for external cron hitting POST /api/surveillance/run
# CRON_SECRET=
